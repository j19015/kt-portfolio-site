# Cloudflare Pages 用のヘッダ設定。
# OG画像は拡張子なしのパスで出力されるため、MIMEを明示しないと
# SNS のクローラが画像として認識しない
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

# ビルドごとにハッシュが変わる静的アセットは長期キャッシュしてよい
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
